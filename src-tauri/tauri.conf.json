{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icarus Journal",
  "version": "0.1.0",
  "identifier": "com.icarus.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Icarus Journal",
        "label": "main",
        "width": 1200,
        "height": 820,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A local-first journaling app backed by iCalendar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
