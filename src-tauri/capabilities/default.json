{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Icarus Journal: local file IO, native dialogs, and a settings store. No network access is granted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/mnt/**" },
        { "path": "/media/**" },
        { "path": "/run/media/**" },
        { "path": "/tmp/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/mnt/**" },
        { "path": "/media/**" },
        { "path": "/run/media/**" },
        { "path": "/tmp/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/mnt/**" },
        { "path": "/media/**" },
        { "path": "/run/media/**" },
        { "path": "/tmp/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/mnt/**" },
        { "path": "/media/**" },
        { "path": "/run/media/**" },
        { "path": "/tmp/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/mnt/**" },
        { "path": "/media/**" },
        { "path": "/run/media/**" },
        { "path": "/tmp/**" }
      ]
    }
  ]
}
