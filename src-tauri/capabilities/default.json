{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Icarus Diary: filesystem access is scoped to paths the user selects in a dialog or drops onto the window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "opener:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists"
  ]
}
