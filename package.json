{
  "name": "icarus-diary",
  "version": "0.1.0",
  "description": "Icarus Diary — a local-first, air-gapped diarying app backed by iCalendar.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:seed": "vite --mode seed",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icon": "node scripts/gen-icon.mjs && tauri icon ./app-icon.png",
    "tauri": "tauri",
    "tauri:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "tauri:build": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-list-keymap": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.5.0",
    "ical.js": "^2.2.1",
    "markdown-it": "^14.3.3",
    "nspell": "^2.1.5",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/markdown-it": "^14.2.0",
    "dictionary-en": "^4.0.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
